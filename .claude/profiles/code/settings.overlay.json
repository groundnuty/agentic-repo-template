{
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "sandbox": {
    "excludedCommands": [
      "helm:*",
      "kubectl:*",
      "kustomize:*",
      "terraform:*",
      "docker:*",
      "podman:*"
    ]
  },
  "permissions": {
    "allow": [
      "mcp__kubernetes__*",
      "mcp__db__*",
      "mcp__prometheus__*"
    ]
  }
}
