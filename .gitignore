# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Node
node_modules/
dist/
.npm/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Go
vendor/

# Build artifacts
build/
out/
target/

# Secrets (CRITICAL)
.mcp.json
k8s-mcp.toml
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Logs
*.log
!.claude/audit.log

# Claude local-only state
.claude/settings.local.json
.claude/.cache/

# Session reports — machine-generated by the SessionEnd/PreCompact hooks, and by
# every `claude plugin install` (each run leaves a fresh session-end.md). Keep
# the directory, ignore its contents.
.claude/session-reports/*
!.claude/session-reports/.gitkeep

# Template upgrade backups
.claude.pre-upgrade-*/
